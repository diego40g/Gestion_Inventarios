# Configuración de direnv para NixOS
# Este archivo carga automáticamente el entorno de desarrollo
# cuando entras al directorio del proyecto

# Usar flakes de Nix
use flake

# Cambiar al directorio del proyecto Maven
cd inventario

# Opcional: Configuración adicional
# Si necesitas variables de entorno personalizadas, agrégalas aquí
# export CUSTOM_VAR="valor"

# Mensaje de bienvenida
echo "✅ Entorno Nix cargado automáticamente con direnv"
echo "📂 Directorio de trabajo: $(pwd)"
